---
import { Image } from 'astro:assets';
import logo from '../assets/logo-isotipo.png';
import { site } from '../data/site';

interface Props {
  current?: 'inicio' | 'servicios' | 'ninguno';
  contactHref?: string;
  // Mensaje de WhatsApp del botón Cotizar; en las páginas de servicio incluye el servicio.
  waHref?: string;
}

const { current = 'inicio', contactHref = '#contacto', waHref = `${site.whatsapp}?text=${encodeURIComponent('Hola, quisiera una cotización')}` } = Astro.props;

const links = [
  { href: '/', label: 'Inicio', current: current === 'inicio' },
  { href: '/#servicios', label: 'Servicios', current: current === 'servicios' },
  { href: '/#productos', label: 'Productos' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#galeria', label: 'Galería' },
  { href: contactHref, label: 'Contacto' },
];
---

<header class="header" data-header>
  <div class="header__bar">
    <a href="/" class="brand">
      <Image src={logo} alt="Logo de Portugal Seguridad" height={100} class="brand__logo" loading="eager" />
      <span class="brand__text">
        <span class="brand__name">PORTUGAL</span>
        <span class="brand__sub">CONTRA INCENDIOS</span>
      </span>
    </a>
    <nav class="nav" aria-label="Principal">
      {links.map((l) => <a href={l.href} aria-current={l.current ? 'true' : undefined}>{l.label}</a>)}
    </nav>
    <div class="header__actions">
      <a href={waHref} class="pill" target="_blank" rel="noopener" aria-label="Cotizar por WhatsApp">Cotizar</a>
      <button class="menu-btn" type="button" aria-label="Menú" aria-expanded="false" aria-controls="menu-movil" data-menu-btn>☰</button>
    </div>
  </div>
  <nav class="nav-mobile" id="menu-movil" aria-label="Móvil" data-menu>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href={`tel:${site.phone}`}>Llamar · {site.phoneDisplay}</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-compact', window.scrollY > 20);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (btn && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => setOpen(!menu.classList.contains('is-open')));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>
